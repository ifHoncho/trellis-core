[Unit]
Description=Trellis mesh daemon (meshd)
After=network-pre.target systemd-modules-load.service
# Start after the system's network managers, so that the auto-port check
# (r_ports.go) sees which Ethernet ports they configure instead of claiming
# one they are about to set up. Ordering only: neither is required.
After=NetworkManager.service systemd-networkd.service
Wants=network-pre.target
# meshd owns its interfaces; nothing else should configure them.
Before=network.target

[Service]
Type=simple
ExecStart=/usr/bin/trellis meshd --node /etc/trellis/node.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=30
# meshd runs as root, bounded to what running a node's network needs. Its
# helpers (hostapd and wpa_supplicant, which parse frames from anyone in
# radio range, and dnsmasq) inherit the same bounds. docs/security.md.
#   NET_ADMIN, NET_RAW: interfaces, routes, nftables, nl80211, batman-adv,
#     packet sockets, WAN probes. NET_BIND_SERVICE: dnsmasq on 53 and 67.
#   SYS_MODULE: loading batman-adv. SETUID, SETGID, SETPCAP: dnsmasq drops
#     to its own user. KILL: signalling it there. CHOWN: the API socket's
#     group. DAC_OVERRIDE: chronyd's command socket, in a directory only
#     chrony may open. SYSLOG: the host checks (run through the API) read
#     the kernel log, which distributions restrict (dmesg_restrict).
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_MODULE CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_KILL CAP_CHOWN CAP_DAC_OVERRIDE CAP_SYSLOG
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHostname=yes
# Not set, on purpose: ProtectKernelTunables (meshd writes net.* sysctls and
# radio LEDs), ProtectKernelModules (it loads batman-adv), PrivateDevices
# (rfkill), ProtectKernelLogs (the host checks read the kernel log), and
# ProtectClock, which implies a device allow-list that would take
# /dev/rfkill and /dev/kmsg from meshd and its helpers.
ProtectSystem=full
# /etc/trellis: configuration changes made through the API (web UI,
# meshctl) are written to node.yaml and profile.yaml there.
ReadWritePaths=/var/lib/trellis /run/trellis /etc/trellis -/etc/NetworkManager/conf.d -/etc/systemd/network
RuntimeDirectory=trellis
RuntimeDirectoryMode=0755
StateDirectory=trellis
Environment=GOTRACEBACK=single

[Install]
WantedBy=multi-user.target
