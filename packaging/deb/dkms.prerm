#!/bin/sh
# trellis-batman-adv-dkms: before removal, take the module out of DKMS;
# the kernel's own batman-adv is used again. An upgrade leaves it: the new
# package's install removes other releases once its own is built, so a node
# whose new build fails keeps a working module.
set -e
case "$1" in
  remove|deconfigure)
    if command -v dkms >/dev/null 2>&1; then
      dkms status 2>/dev/null | sed -n -E 's|^trellis-batman-adv[/,] *([^,:]+).*|\1|p' | sort -u | while read -r v; do
        [ -n "$v" ] && dkms remove "trellis-batman-adv/$v" --all >/dev/null 2>&1 || true
      done
    fi
    ;;
esac
exit 0
