#!/bin/sh
# trellis-voice: let voiced read CM108 adapters already plugged in, and
# tell systemd about its unit. meshd starts it when voice.enable is set.
set -e
[ "$1" = configure ] || exit 0
# The voice service's group: the trellis package makes it; made here too,
# for a trellis package from before it did.
getent group trellis-voice >/dev/null 2>&1 || groupadd --system trellis-voice
if command -v udevadm >/dev/null 2>&1; then
  udevadm control --reload 2>/dev/null || true
  udevadm trigger --subsystem-match=hidraw 2>/dev/null || true
fi
if [ -d /run/systemd/system ]; then
  systemctl daemon-reload || true
  # Running already (an upgrade): the new binary.
  systemctl try-restart trellis-voiced.service || true
fi
exit 0
